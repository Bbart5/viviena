GMAIL_USER=''  
GMAIL_APP_PASSWORD=''

DATABASE_URL='postgresql://viviena:viviena@localhost:5432/viviena?schema=public'

JWT_SECRET=''

ENVIRONMENT='development' # production or development

SEED_USERS=''

# Object storage — dev: MinIO (docker-compose), prod: Cloudflare R2.
# All vars must exist in every environment (empty strings ok) — $env/static/private fails the build otherwise.
S3_ENDPOINT='http://localhost:9000' # prod: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID='viviena'
S3_SECRET_ACCESS_KEY='viviena-dev'
S3_BUCKET='viviena-media'
S3_REGION='us-east-1' # prod (R2): 'auto'
S3_FORCE_PATH_STYLE='true' # prod (R2): 'false'
S3_PUBLIC_BASE_URL='http://localhost:9000/viviena-media' # prod: r2.dev URL or custom domain

# Cloudflare R2 analytics (production only; keep as empty strings in dev)
CLOUDFLARE_ACCOUNT_ID=''
CLOUDFLARE_API_TOKEN='' # token scope: Account Analytics: Read
