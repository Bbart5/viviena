enum TeamGroup {
  BOARD
  REVISION
}

model TeamMember {
  id String @id @default(uuid()) @db.Uuid

  name  String
  role  String
  group TeamGroup

  imageMediaId String? @db.Uuid
  imageMedia   Media?  @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
