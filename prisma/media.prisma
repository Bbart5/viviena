enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

model Media {
  id       String    @id @default(uuid()) @db.Uuid
  type     MediaType
  key      String    @unique
  url      String
  filename String
  mimeType String
  size     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  heroes Hero[]
}
