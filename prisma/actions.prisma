model Action {
  id String @id @default(uuid()) @db.Uuid

  title String
  date  String

  tag      String
  tagColor String

  description String @db.Text
  relation    String @db.Text

  showCta  Boolean @default(false)
  ctaLabel String

  details  String[]
  people   String[]
  partners String[]

  imageMediaId String? @db.Uuid
  imageMedia   Media?  @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
